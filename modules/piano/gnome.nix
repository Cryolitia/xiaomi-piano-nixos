{
  config,
  lib,
  pkgs,
  pianoPackages,
  ...
}:

let
  powerOverlay = "${pianoPackages.bsp.src}/linux/desktops/gnome/power-overlay";
  powerProfiles = [
    "piano-power-saver"
    "piano-balanced"
    "piano-performance"
  ];
  powerDatabase = {
    settings."org/gnome/settings-daemon/plugins/power" = {
      power-button-action = "suspend";
      sleep-inactive-ac-type = "nothing";
      sleep-inactive-battery-type = "suspend";
    };
  };
in
{
  config = lib.mkIf config.services.desktopManager.gnome.enable {
    # NixOS uses this package for the daemon, user units and udev rules.
    nixpkgs.overlays = [
      (_final: previous: {
        gnome-settings-daemon = previous.callPackage ../../packages/gnome-settings-daemon {
          inherit (previous) gnome-settings-daemon;
        };
      })
    ];

    services.tuned = {
      enable = lib.mkDefault true;
      ppdSupport = lib.mkDefault true;
      # Keep GNOME's power mode selector as the desktop entry point.
      package = lib.mkDefault (
        pkgs.tuned.overrideAttrs (old: {
          postInstall = (old.postInstall or "") + ''
            rm -f "$out/share/applications/tuned-gui.desktop"
          '';
        })
      );
    };

    environment.etc =
      lib.listToAttrs (
        map (
          name:
          lib.nameValuePair "tuned/profiles/${name}/tuned.conf" {
            text = builtins.readFile "${powerOverlay}/usr/lib/tuned/profiles/${name}/tuned.conf";
          }
        ) powerProfiles
      )
      // {
        # Use the board mapping, including its battery profile, instead of the
        # generic mapping generated by the TuneD module.
        "tuned/ppd.conf".text = lib.mkForce (builtins.readFile "${powerOverlay}/etc/tuned/piano-ppd.conf");
      };

    # Keep screen blanking and locking on AC; suspend automatically on battery.
    programs.dconf.profiles = {
      user.databases = [ powerDatabase ];
      gdm = lib.mkIf config.services.displayManager.gdm.enable {
        databases = [ powerDatabase ];
      };
    };

    services.logind.settings.Login = {
      HandleLidSwitch = lib.mkDefault "suspend";
      HandleLidSwitchExternalPower = lib.mkDefault "lock";
    };

    # Explicit suspend requests, including the native power key, still use deep.
    systemd.sleep.settings.Sleep.MemorySleepMode = lib.mkDefault "deep";
  };
}
