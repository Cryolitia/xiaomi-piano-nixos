Subject: [PATCH] PCI: qcom: power endpoint devices before enabling PHYs

Create and power on the endpoint power-control devices while PERST# is
asserted, before enabling the host PHYs. If a power-control driver has not
bound yet, defer without unnecessarily powering up and then shutting down
the PHYs before the next probe attempt.

Unwind the initialized resources in reverse order. Preserve power-control
devices on probe deferral and keep the existing suspend and retained-power
conditions. A failed PHY power-on already handles its PHY cleanup, so only
unwind endpoint power and controller initialization on that path.

---
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -1528,16 +1528,10 @@
 	if (ret)
 		return ret;
 
-	PIANO_MARK(pci->dev, "H1 phy power-on");
-	ret = qcom_pcie_phy_power_on(pcie);
-	if (ret)
-		goto err_deinit;
-	PIANO_MARK(pci->dev, "H2 phy up");
-
 	if (!pci->suspended) {
 		ret = pci_pwrctrl_create_devices(pci->dev);
 		if (ret)
-			goto err_disable_phy;
+			goto err_deinit;
 	}
 
 	if (!pp->skip_pwrctrl_off) {
@@ -1545,12 +1539,18 @@
 		if (ret)
 			goto err_pwrctrl_destroy;
 	}
+
+	PIANO_MARK(pci->dev, "H1 phy power-on");
+	ret = qcom_pcie_phy_power_on(pcie);
+	if (ret)
+		goto err_pwrctrl_power_off;
+	PIANO_MARK(pci->dev, "H2 phy up");
 	PIANO_MARK(pci->dev, "H3 pwrctrl on");
 
 	if (pcie->cfg->ops->post_init) {
 		ret = pcie->cfg->ops->post_init(pcie);
 		if (ret)
-			goto err_pwrctrl_power_off;
+			goto err_disable_phy;
 	}
 	PIANO_MARK(pci->dev, "H4 post_init done (first DBI access passed)");
 
@@ -1575,14 +1575,14 @@
 
 err_assert_reset:
 	qcom_pcie_perst_assert(pcie);
+err_disable_phy:
+	qcom_pcie_phy_power_off(pcie);
 err_pwrctrl_power_off:
 	if (!pp->skip_pwrctrl_off)
 		pci_pwrctrl_power_off_devices(pci->dev);
 err_pwrctrl_destroy:
 	if (ret != -EPROBE_DEFER && !pci->suspended)
 		pci_pwrctrl_destroy_devices(pci->dev);
-err_disable_phy:
-	qcom_pcie_phy_power_off(pcie);
 err_deinit:
 	pcie->cfg->ops->deinit(pcie);
 
