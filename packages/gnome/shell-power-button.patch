Subject: [PATCH] screen-shield: provide an immediate lock for power button handling

Include display power state in accelerator metadata. Add a non-animated
ScreenSaver lock entry point so a power-button wake cannot be followed by
a delayed lock fade. Preserve the existing animated Lock method.

diff --git a/data/dbus-interfaces/org.gnome.ScreenSaver.xml b/data/dbus-interfaces/org.gnome.ScreenSaver.xml
--- a/data/dbus-interfaces/org.gnome.ScreenSaver.xml
+++ b/data/dbus-interfaces/org.gnome.ScreenSaver.xml
@@ -1,6 +1,7 @@
 <node>
   <interface name="org.gnome.ScreenSaver">
     <method name="Lock"/>
+    <method name="LockImmediately"/>
     <method name="GetActive">
       <arg type="b" direction="out" name="active"/>
     </method>
diff --git a/js/dbusServices/screensaver/screenSaverService.js b/js/dbusServices/screensaver/screenSaverService.js
--- a/js/dbusServices/screensaver/screenSaverService.js
+++ b/js/dbusServices/screensaver/screenSaverService.js
@@ -40,6 +40,15 @@
         }
     }
 
+    async LockImmediatelyAsync(params, invocation) {
+        try {
+            await this._proxy.LockImmediatelyAsync(...params);
+            invocation.return_value(null);
+        } catch (error) {
+            this._handleError(invocation, error);
+        }
+    }
+
     async GetActiveAsync(params, invocation) {
         try {
             const res = await this._proxy.GetActiveAsync(...params);
