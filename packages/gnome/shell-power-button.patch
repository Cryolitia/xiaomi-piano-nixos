         this._setLocked(lock);
     }
 
+    lockImmediately() {
+        if (this._deactivating || this._lockSettings.get_boolean(DISABLE_LOCK_KEY))
+            return false;
+
+        this.lock(false);
+        if (!this.locked || !this._dialog || !this._grab || !this.actor.visible)
+            return false;
+
+        // activate() does not reset a shield that is already showing.
+        // Finish that transition too, and cancel its delayed fade.
+        this._lockDialogGroup.remove_all_transitions();
+        this._lockDialogGroup.translation_y = 0;
+        this._lockScreenGroup.show();
+        this._lockScreenShown({fadeToBlack: true, animateFade: false});
+        return this.active;
+    }
+
     // If the previous shell crashed, and gnome-session restarted us, then re-lock
     lockIfWasLocked() {
         if (!this._settings.get_boolean(LOCK_ENABLED_KEY))
