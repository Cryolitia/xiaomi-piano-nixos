+    LockImmediatelyAsync(_parameters, invocation) {
+        // The power-button action must not leave a delayed fade that can
+        // blank the screen after a subsequent wake-up request.
+        if (!this._screenShield.lockImmediately()) {
+            invocation.return_error_literal(
+                Gio.DBusError, Gio.DBusError.FAILED, 'Could not lock the screen');
+            return;
+        }
+        invocation.return_value(null);
+    }
+
     SetActive(active) {
         if (active)
             this._screenShield.activate(true);
