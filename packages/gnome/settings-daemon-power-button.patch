   GSD_POWER_BUTTON_ACTION_SUSPEND,
   GSD_POWER_BUTTON_ACTION_HIBERNATE,
-  GSD_POWER_BUTTON_ACTION_INTERACTIVE
+  GSD_POWER_BUTTON_ACTION_INTERACTIVE,
+  GSD_POWER_BUTTON_ACTION_LOCK_SCREEN
 } GsdPowerButtonActionType;
 
