+static void
+power_button_complete (GsdPowerManager *manager,
+                       const GError    *error)
+{
+        if (manager->power_button_invocation) {
+                if (error)
+                        g_dbus_method_invocation_return_gerror (manager->power_button_invocation, error);
+                else
+                        g_dbus_method_invocation_return_value (manager->power_button_invocation, NULL);
+                g_clear_object (&manager->power_button_invocation);
+        }
+        g_clear_object (&manager->power_button_cancellable);
+}
+
+static void
+power_button_readback_done (GObject      *source,
+                            GAsyncResult *result,
+                            gpointer      user_data)
+{
+        g_autoptr(GsdPowerManager) manager = user_data;
+        g_autoptr(GVariant) reply = NULL;
+        g_autoptr(GVariant) wrapped = NULL;
+        g_autoptr(GVariant) mode = NULL;
+        g_autoptr(GError) error = NULL;
+
+        reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+        if (!manager->power_button_invocation)
+                return;
+        if (reply) {
+                g_variant_get (reply, "(@v)", &wrapped);
+                mode = g_variant_get_variant (wrapped);
+                if (!g_variant_is_of_type (mode, G_VARIANT_TYPE_INT32) ||
+                    g_variant_get_int32 (mode) != manager->power_button_target_mode)
+                        g_set_error_literal (&error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                                             "The display did not enter the requested power mode");
+        }
+        power_button_complete (manager, error);
+}
+
+static void
+power_button_set_idle (GsdPowerManager *manager)
+{
+        GDBusProxy *display_config = G_DBUS_PROXY (manager->display_config);
+
+        if (!manager->session || !manager->session_is_active) {
+                g_autoptr(GError) error = g_error_new_literal (G_DBUS_ERROR, G_DBUS_ERROR_ACCESS_DENIED,
+                                                              "The session is no longer active");
+                power_button_complete (manager, error);
+                return;
+        }
+
+        if (manager->power_button_target_mode == GSD_POWER_SAVE_MODE_OFF) {
+                if (manager->current_idle_mode == GSD_POWER_IDLE_MODE_BLANK)
+                        disable_monitors (manager);
+                else
+                        idle_set_mode (manager, GSD_POWER_IDLE_MODE_BLANK);
+        } else {
+                idle_set_mode (manager, GSD_POWER_IDLE_MODE_NORMAL);
+        }
+
+        /* The ordinary setter and this readback use the same connection.
+         * Do not report success merely because the asynchronous set started. */
+        g_dbus_connection_call (g_dbus_proxy_get_connection (display_config),
+                                g_dbus_proxy_get_name (display_config),
+                                g_dbus_proxy_get_object_path (display_config),
+                                "org.freedesktop.DBus.Properties", "Get",
+                                g_variant_new ("(ss)", "org.gnome.Mutter.DisplayConfig", "PowerSaveMode"),
+                                G_VARIANT_TYPE ("(v)"), G_DBUS_CALL_FLAGS_NONE, -1,
+                                manager->power_button_cancellable,
+                                power_button_readback_done, g_object_ref (manager));
+}
+
+static void
+power_button_locked (GObject      *source,
+                     GAsyncResult *result,
+                     gpointer      user_data)
+{
+        g_autoptr(GsdPowerManager) manager = user_data;
+        g_autoptr(GVariant) reply = NULL;
+        g_autoptr(GError) error = NULL;
+
+        reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+        if (!manager->power_button_invocation)
+                return;
+        if (!reply) {
+                power_button_complete (manager, error);
+                return;
+        }
+        power_button_set_idle (manager);
+}
+
+static void
+handle_power_button (GsdPowerManager       *manager,
+                      GVariant              *parameters,
+                      GDBusMethodInvocation *invocation)
+{
+        gint press_power_save_mode;
+
+        if (!manager->session || !manager->session_is_active) {
+                g_dbus_method_invocation_return_error_literal (invocation, G_DBUS_ERROR,
+                                                               G_DBUS_ERROR_ACCESS_DENIED,
+                                                               "The session is not active");
+                return;
+        }
+        if (manager->power_button_invocation) {
+                g_dbus_method_invocation_return_dbus_error (invocation,
+                        "org.gnome.SettingsDaemon.Power.Error.Busy", "A power button action is pending");
+                return;
+        }
+        g_variant_get (parameters, "(i)", &press_power_save_mode);
+        if (press_power_save_mode < GSD_POWER_SAVE_MODE_ON ||
+            press_power_save_mode > GSD_POWER_SAVE_MODE_OFF ||
+            g_settings_get_enum (manager->settings, "power-button-action") !=
+            GSD_POWER_BUTTON_ACTION_LOCK_SCREEN) {
+                g_dbus_method_invocation_return_error_literal (invocation, G_DBUS_ERROR,
+                                                               G_DBUS_ERROR_INVALID_ARGS,
+                                                               "The lock-screen action needs a valid press-time display state");
+                return;
+        }
+
+        manager->power_button_invocation = g_object_ref (invocation);
+        manager->power_button_cancellable = g_cancellable_new ();
+        manager->power_button_target_mode = press_power_save_mode == GSD_POWER_SAVE_MODE_ON ?
+                                            GSD_POWER_SAVE_MODE_OFF : GSD_POWER_SAVE_MODE_ON;
+        if (manager->power_button_target_mode == GSD_POWER_SAVE_MODE_OFF) {
+                /* This completes after the synchronous, non-animated lock.
+                 * Its ActiveChanged signal is ordered before the reply, so
+                 * a later fade cannot overwrite the next wake-up action. */
+                g_dbus_proxy_call (G_DBUS_PROXY (manager->screensaver_proxy), "LockImmediately", NULL,
+                                   G_DBUS_CALL_FLAGS_NONE, -1, manager->power_button_cancellable,
+                                   power_button_locked, g_object_ref (manager));
+        } else {
+                power_button_set_idle (manager);
+        }
+}
+
 static gboolean
