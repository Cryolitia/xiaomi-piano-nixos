 static void
+power_button_action_done (GObject      *source,
+                          GAsyncResult *result,
+                          gpointer      user_data)
+{
+        g_autoptr(GVariant) reply = NULL;
+        g_autoptr(GError) error = NULL;
+        g_autofree char *remote_error = NULL;
+
+        reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), result, &error);
+        if (reply || g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+                return;
+
+        remote_error = g_dbus_error_get_remote_error (error);
+        if (g_strcmp0 (remote_error, "org.gnome.SettingsDaemon.Power.Error.Busy") == 0)
+                g_debug ("Ignoring power button while the previous action is pending");
+        else
+                g_warning ("Power button lock-screen action failed: %s", error->message);
+}
