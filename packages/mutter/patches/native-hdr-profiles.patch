+static const ClutterLuminance native_hdr_luminance = {
+  .type = CLUTTER_LUMINANCE_TYPE_EXPLICIT,
+  .min = 0.8f,
+  .max = 800.0f,
+  .ref = 203.0f,
+  .mastering_max = 800.0f,
