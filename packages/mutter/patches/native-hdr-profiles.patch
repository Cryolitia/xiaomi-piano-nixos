+
+static cmsInt32Number
+identity_clut (const cmsFloat32Number input[],
+               cmsFloat32Number       output[],
+               void                  *user_data)
+{
+  memcpy (output, input, 3 * sizeof (float));
+  return TRUE;
+}
+
+static void
+add_native_output_pipeline (cmsHPROFILE profile)
+{
+  const cmsCIEXYZ *r = cmsReadTag (profile, cmsSigRedColorantTag);
+  const cmsCIEXYZ *g = cmsReadTag (profile, cmsSigGreenColorantTag);
+  const cmsCIEXYZ *b = cmsReadTag (profile, cmsSigBlueColorantTag);
+  graphene_matrix_t to_XYZ, from_XYZ;
+  float inverse[16];
+  cmsFloat64Number matrix[9];
+  cmsPipeline *pipeline = cmsPipelineAlloc (NULL, 3, 3);
+  const float identity_points[] = { 0, 1 };
+  g_autofree float *encoding_points = g_new (float, 32767);
+  cmsToneCurve *identity, *encoding;
+  for (int i = 0; i < 32767; i++)
+    encoding_points[i] = powf (i / 32766.0f, 1.0f / 2.2f);
+  identity = cmsBuildTabulatedToneCurveFloat (NULL, 2, identity_points);
+  encoding = cmsBuildTabulatedToneCurveFloat (NULL, 32767, encoding_points);
+  cmsToneCurve *identity_curves[] = { identity, identity, identity };
+  cmsToneCurve *encoding_curves[] = { encoding, encoding, encoding };
+  cmsStage *clut = cmsStageAllocCLutFloat (NULL, 17, 3, 3, NULL);
+
+  graphene_matrix_init_from_float (&to_XYZ, (float[16]) {
+    r->X, r->Y, r->Z, 0, g->X, g->Y, g->Z, 0, b->X, b->Y, b->Z, 0, 0, 0, 0, 1,
+  });
+  g_assert_true (graphene_matrix_inverse (&to_XYZ, &from_XYZ));
+  graphene_matrix_to_float (&from_XYZ, inverse);
+  for (int row = 0; row < 3; row++)
+    for (int column = 0; column < 3; column++)
+      matrix[row * 3 + column] = inverse[column * 4 + row];
+
+  /* A synthetic ICC with the same standard stage types as calibrated native
+   * displays exercises the exact GPU path without shipping factory tables.
+   */
+  g_assert_true (cmsStageSampleCLutFloat (clut, identity_clut, NULL, 0));
+  cmsPipelineInsertStage (pipeline, cmsAT_END, cmsStageAllocToneCurves (NULL, 3, identity_curves));
+  cmsPipelineInsertStage (pipeline, cmsAT_END, cmsStageAllocMatrix (NULL, 3, 3, matrix, NULL));
+  cmsPipelineInsertStage (pipeline, cmsAT_END, cmsStageAllocToneCurves (NULL, 3, encoding_curves));
+  cmsPipelineInsertStage (pipeline, cmsAT_END, cmsStageAllocToneCurves (NULL, 3, identity_curves));
+  cmsPipelineInsertStage (pipeline, cmsAT_END, clut);
+  cmsPipelineInsertStage (pipeline, cmsAT_END, cmsStageAllocToneCurves (NULL, 3, identity_curves));
+  g_assert_true (cmsWriteTag (profile, cmsSigBToD1Tag, pipeline));
+  cmsPipelineFree (pipeline);
+  cmsFreeToneCurve (identity);
+  cmsFreeToneCurve (encoding);
+}
+
+static ClutterColorState *
+create_native_hdr_color_state (const ClutterLuminance *luminance)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  cmsCIExyY white = { 0.3127, 0.3290, 1.0 };
+  cmsCIExyYTRIPLE primaries = {
+    .Red = { 0.680, 0.320, 1.0 },
+    .Green = { 0.265, 0.690, 1.0 },
+    .Blue = { 0.150, 0.060, 1.0 },
+  };
+  cmsToneCurve *gamma = cmsBuildGamma (NULL, 2.2);
+  cmsToneCurve *curves[] = { gamma, gamma, gamma };
+  cmsHPROFILE profile = cmsCreateRGBProfile (&white, &primaries, curves);
+  cmsUInt32Number length = 0;
+  g_autofree uint8_t *bytes = NULL;
+  ClutterColorState *state;
+
+  g_assert_nonnull (profile);
+  cmsSetProfileVersion (profile, 4.3);
+  add_native_output_pipeline (profile);
+  g_assert_true (cmsSaveProfileToMem (profile, NULL, &length));
+  bytes = g_malloc (length);
+  g_assert_true (cmsSaveProfileToMem (profile, bytes, &length));
+  state = clutter_color_state_icc_new_with_luminance (context, bytes, length,
+                                                     luminance, NULL);
+  cmsCloseProfile (profile);
+  cmsFreeToneCurve (gamma);
+  g_assert_nonnull (state);
+  return state;
+}
