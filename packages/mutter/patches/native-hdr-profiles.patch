@@ -0,0 +1,204 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "config.h"
+
+#include "backends/native/meta-native-hdr-profile.h"
+
+#include <gudev/gudev.h>
+#include <lcms2.h>
+#include <math.h>
+#include <wchar.h>
+
+static char *
+get_metadata (cmsHPROFILE  profile,
+              const wchar_t *key)
+{
+  cmsHANDLE metadata = cmsReadTag (profile, cmsSigMetaTag);
+
+  if (!metadata)
+    return NULL;
+
+  for (const cmsDICTentry *entry = cmsDictGetEntryList (metadata);
+       entry; entry = entry->Next)
+    {
+      if (wcscmp (entry->Name, key) == 0 && entry->Value)
+        return g_ucs4_to_utf8 ((const gunichar *) entry->Value, -1,
+                               NULL, NULL, NULL);
+    }
+
+  return NULL;
+}
+
+static gboolean
+matches_panel (GUdevClient *client,
+               const char  *compatible)
+{
+  GList *panels = g_udev_client_query_by_subsystem (client, "mipi-dsi");
+  gboolean matches = FALSE;
+
+  for (GList *l = panels; l && !matches; l = l->next)
+    {
+      GUdevDevice *panel = l->data;
+
+      for (unsigned int i = 0; ; i++)
+        {
+          g_autofree char *property = g_strdup_printf ("OF_COMPATIBLE_%u", i);
+          const char *value = g_udev_device_get_property (panel, property);
+
+          if (!value)
+            break;
+          if (g_str_equal (value, compatible))
+            {
+              matches = TRUE;
+              break;
+            }
+        }
+    }
+
+  g_list_free_full (panels, g_object_unref);
+  return matches;
+}
+
+static GArray *
+parse_backlight_curve (const char *text)
+{
+  g_autoptr (GArray) curve = g_array_new (FALSE, FALSE,
+                                         sizeof (MetaNativeHdrBacklightPoint));
+  g_auto (GStrv) rows = NULL;
+
+  if (!text)
+    return NULL;
+  rows = g_strsplit (text, ";", -1);
+  for (int i = 0; rows[i]; i++)
+    {
+      MetaNativeHdrBacklightPoint point;
+      char *end;
+      const char *luminance;
+
+      point.brightness = g_ascii_strtod (rows[i], &end);
+      if (end == rows[i] || *end != ':')
+        return NULL;
+      luminance = end + 1;
+      point.luminance = g_ascii_strtod (luminance, &end);
+      if (end == luminance || *end ||
+          !isfinite (point.brightness) || !isfinite (point.luminance) ||
+          point.brightness < 0.0 || point.brightness > 1.0 ||
+          point.luminance < 0.0 || point.luminance > 1.0)
+        return NULL;
+      if (curve->len)
+        {
+          MetaNativeHdrBacklightPoint previous =
+            g_array_index (curve, MetaNativeHdrBacklightPoint, curve->len - 1);
+
+          if (point.brightness <= previous.brightness ||
+              point.luminance < previous.luminance)
+            return NULL;
+        }
+      g_array_append_val (curve, point);
+    }
+
+  if (curve->len < 2 ||
+      g_array_index (curve, MetaNativeHdrBacklightPoint, 0).brightness != 0.0 ||
+      g_array_index (curve, MetaNativeHdrBacklightPoint, curve->len - 1).brightness != 1.0 ||
+      g_array_index (curve, MetaNativeHdrBacklightPoint, curve->len - 1).luminance != 1.0)
+    return NULL;
+
+  return g_steal_pointer (&curve);
+}
+
+static gboolean
+try_profile (MetaOutputInfo *output_info,
+             GUdevClient    *client,
+             const char     *path)
+{
+  g_autofree char *contents = NULL;
+  g_autofree char *enabled = NULL;
+  g_autofree char *compatible = NULL;
+  g_autofree char *backlight = NULL;
+  g_autoptr (GArray) curve = NULL;
+  cmsHPROFILE profile;
+  const cmsCIEXYZ *white_luminance, *black;
+  double max_luminance, min_luminance;
+  gsize length;
+
+  if (!g_file_get_contents (path, &contents, &length, NULL) || length > G_MAXUINT32)
+    return FALSE;
+  profile = cmsOpenProfileFromMem (contents, length);
+  if (!profile)
+    return FALSE;
+
+  enabled = get_metadata (profile, L"MUTTER_native_hdr");
+  compatible = get_metadata (profile, L"MAPPING_device_of_compatible");
+  if (g_strcmp0 (enabled, "1") != 0 || !compatible ||
+      !matches_panel (client, compatible) ||
+      cmsGetDeviceClass (profile) != cmsSigDisplayClass ||
+      cmsGetColorSpace (profile) != cmsSigRgbData ||
+      cmsGetPCS (profile) != cmsSigXYZData)
+    goto out;
+
+  white_luminance = cmsReadTag (profile, cmsSigLuminanceTag);
+  black = cmsReadTag (profile, cmsSigMediaBlackPointTag);
+  if (!white_luminance || !black)
+    goto out;
+  max_luminance = white_luminance->Y;
+  min_luminance = black->Y * max_luminance;
+  if (!isfinite (max_luminance) || !isfinite (min_luminance) ||
+      max_luminance <= 203.0 || min_luminance < 0.0 ||
+      min_luminance >= 203.0)
+    goto out;
+
+  backlight = get_metadata (profile, L"MUTTER_backlight_luminance");
+  curve = parse_backlight_curve (backlight);
+  if (!curve)
+    goto out;
+
+  output_info->native_hdr_profile = g_bytes_new_take (
+    g_steal_pointer (&contents), length);
+  output_info->native_hdr_max_luminance = max_luminance;
+  output_info->native_hdr_min_luminance = min_luminance;
+  output_info->native_hdr_reference = get_metadata (profile, L"MUTTER_native_hdr_reference");
+  output_info->native_hdr_backlight_curve = g_steal_pointer (&curve);
+  cmsCloseProfile (profile);
+  return TRUE;
+
+out:
+  cmsCloseProfile (profile);
+  return FALSE;
+}
+
+void
+meta_native_hdr_profile_load (MetaOutputInfo *output_info)
+{
+  const char *subsystems[] = { "mipi-dsi", NULL };
+  const char * const *data_dirs = g_get_system_data_dirs ();
+  g_autoptr (GUdevClient) client = NULL;
+
+  if (output_info->connector_type != META_CONNECTOR_TYPE_DSI)
+    return;
+  client = g_udev_client_new (subsystems);
+
+  for (int i = 0; data_dirs[i]; i++)
+    {
+      g_autofree char *directory = g_build_filename (data_dirs[i], "color", "icc", NULL);
+      g_autoptr (GDir) dir = g_dir_open (directory, 0, NULL);
+      const char *name;
+
+      if (!dir)
+        continue;
+      while ((name = g_dir_read_name (dir)))
+        {
+          g_autofree char *path = NULL;
+
+          if (!g_str_has_suffix (name, ".icc"))
+            continue;
+          path = g_build_filename (directory, name, NULL);
+          if (try_profile (output_info, client, path))
+            {
+              meta_topic (META_DEBUG_COLOR,
+                          "Native HDR profile for %s: %s (%.3f nit peak)",
+                          output_info->name, path,
+                          output_info->native_hdr_max_luminance);
+              return;
+            }
+        }
+    }
+}
