+static void
+color_state_transform_native_hdr_luminance (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  g_autoptr (ClutterColorState) output = NULL;
+  g_autoptr (ClutterColorState) blending = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  g_autoptr (ClutterColorState) linear = NULL;
+  g_autoptr (ClutterColorState) derived = NULL;
+  g_autoptr (ClutterColorState) derived_blending = NULL;
+  ClutterLuminance dim_luminance = native_hdr_luminance;
+  float previous = 0.0f;
+  /* ST2084 encodings of 100, 203, 1000, 4000 and 10000 cd/m². */
+  const float pq_gray[] = { 0.50807842f, 0.58068888f, 0.75182710f,
+                            0.90257239f, 1.0f };
+
+  output = create_native_hdr_color_state (&native_hdr_luminance);
+  g_assert_cmpint (clutter_color_state_required_format (output), ==,
+                   CLUTTER_ENCODING_REQUIRED_FORMAT_UINT10);
+  blending = clutter_color_state_get_blending (output, FALSE);
+  g_assert_cmpint (clutter_color_state_required_format (blending), ==,
+                   CLUTTER_ENCODING_REQUIRED_FORMAT_FP16);
+  g_assert_cmpfloat (clutter_color_state_params_get_luminance (
+                      CLUTTER_COLOR_STATE_PARAMS (blending))->max, ==, 800.0f);
+
+  derived = clutter_color_state_icc_with_luminance (
+    CLUTTER_COLOR_STATE_ICC (output), &native_hdr_luminance);
+  g_assert_true (derived == output);
+  g_clear_object (&derived);
+  dim_luminance.max *= 0.5f;
+  dim_luminance.ref *= 0.5f;
+  dim_luminance.mastering_max *= 0.5f;
+  derived = clutter_color_state_icc_with_luminance (
+    CLUTTER_COLOR_STATE_ICC (output), &dim_luminance);
+  derived_blending = clutter_color_state_get_blending (derived, FALSE);
+  g_assert_true (clutter_color_state_icc_get_file (CLUTTER_COLOR_STATE_ICC (derived)) ==
+                 clutter_color_state_icc_get_file (CLUTTER_COLOR_STATE_ICC (output)));
+  g_assert_true (CLUTTER_IS_COLOR_STATE_PARAMS (derived_blending));
+  g_assert_cmpfloat (clutter_color_state_params_get_luminance (
+                      CLUTTER_COLOR_STATE_PARAMS (derived_blending))->max, ==, 400.0f);
+
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+  linear = clutter_color_state_params_new_full (
+    context, CLUTTER_COLORSPACE_SRGB, CLUTTER_TRANSFER_FUNCTION_LINEAR,
+    NULL, -1.0f, 0.8f, 800.0f, 203.0f, 800.0f);
+
+  for (int i = 0; i < G_N_ELEMENTS (pq_gray); i++)
+    {
+      float gray[3] = { pq_gray[i], pq_gray[i], pq_gray[i] };
+      float nits;
+
+      clutter_color_state_do_transform (pq, output, gray, 1);
+      clutter_color_state_do_transform (output, linear, gray, 1);
+      nits = gray[1] * 800.0f;
+      g_test_message ("HDR gray %d: %.2f nit", i, nits);
+      g_assert_cmpfloat (nits, >, previous);
+      g_assert_cmpfloat (nits, <=, 802.0f);
+      if (i == 0)
+        g_assert_cmpfloat_with_epsilon (nits, 100.0f, 2.0f);
+      if (i == 1)
+        g_assert_cmpfloat_with_epsilon (nits, 203.0f, 2.0f);
+      if (i == G_N_ELEMENTS (pq_gray) - 1)
+        g_assert_cmpfloat_with_epsilon (nits, 800.0f, 2.0f);
+      previous = nits;
+    }
+}
+
+static void
+color_state_transform_native_hdr_dimming (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  ClutterLuminance dim_luminance = native_hdr_luminance;
+  g_autoptr (ClutterColorState) full = NULL;
+  g_autoptr (ClutterColorState) dim = NULL;
+  g_autoptr (ClutterColorState) pq = NULL;
+  float full_gray[] = { 0.75182710f, 0.75182710f, 0.75182710f };
+  float dim_gray[] = { 0.75182710f, 0.75182710f, 0.75182710f };
+
+  dim_luminance.min *= 0.25f;
+  dim_luminance.max *= 0.25f;
+  dim_luminance.ref *= 0.25f;
+  dim_luminance.mastering_max *= 0.25f;
+  full = create_native_hdr_color_state (&native_hdr_luminance);
+  dim = create_native_hdr_color_state (&dim_luminance);
+  pq = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                       CLUTTER_TRANSFER_FUNCTION_PQ);
+
+  g_assert_false (clutter_color_state_equals (full, dim));
+  clutter_color_state_do_transform (pq, full, full_gray, 1);
+  clutter_color_state_do_transform (pq, dim, dim_gray, 1);
+  /* Physical dimming scales peak and reference white together. The same
+   * code values remain appropriate, while the advertised nits change.
+   */
+  for (int i = 0; i < 3; i++)
+    g_assert_cmpfloat_with_epsilon (full_gray[i], dim_gray[i], 0.001f);
+}
+
+static void
+color_state_transform_native_hdr_gpu (void)
+{
+  ClutterContext *context = clutter_test_get_context ();
+  g_autoptr (ClutterColorState) source = NULL;
+  g_autoptr (ClutterColorState) output = NULL;
+  ClutterStageView *view;
+  ClutterActor *stage = clutter_test_get_stage ();
+  GList *actors;
+
+  source = clutter_color_state_params_new (context, CLUTTER_COLORSPACE_BT2020,
+                                           CLUTTER_TRANSFER_FUNCTION_PQ);
+  output = create_native_hdr_color_state (&native_hdr_luminance);
+  actors = create_actors (stage);
+  actors_set_color_state (actors, source);
+  view = get_stage_view (stage);
+  stage_view_set_color_state (view, output);
+  wait_for_paint (stage);
+  validate_transform (stage, source, clutter_stage_view_get_color_state (view), output);
+  g_list_free_full (actors, (GDestroyNotify) clutter_actor_destroy);
+}
+
+static void
+color_state_transform_native_hdr_dark_grays (void)
+{
+  ClutterActor *stage = clutter_test_get_stage ();
+  CoglFramebuffer *stage_fb;
+  CoglContext *cogl_context;
+  CoglPixelFormat formats[] = { COGL_PIXEL_FORMAT_RGBA_FP_16161616_PRE };
+  g_autoptr (CoglOffscreen) fb = NULL;
+  g_autoptr (CoglPipeline) pipeline = NULL;
+  g_autoptr (CoglSnippet) input = cogl_snippet_new (
+    COGL_SNIPPET_HOOK_FRAGMENT, "uniform vec3 input_rgb;",
+    "cogl_color_out = vec4 (input_rgb, 1.0);");
+  g_autoptr (ClutterColorState) output = create_native_hdr_color_state (&native_hdr_luminance);
+  g_autoptr (ClutterColorState) linear = NULL;
+  const float levels[] = {
+    0.000001f, 0.00001f, 0.0001f, 0.001f, 0.01f,
+    0.0008f, 0.0009f, 0.0011f, 0.0012f, 0.0018f, 0.002f,
+    0.1f, 0.5f, 1.0f, 4.0f, 16.0f,
+  };
+  const float patterns[][3] = {
+    { 1, 1, 1 }, { 0.9f, 1, 1.1f }, { 1.1f, 1, 0.9f },
+    { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 },
+    { 1, 0.1f, 0.01f }, { 0.01f, 0.1f, 1 },
+  };
+  const char *profile_path = g_getenv ("MUTTER_NATIVE_HDR_PROFILE");
+  float maximum_error = 0.0f;
+
+  wait_for_paint (stage);
+  stage_fb = clutter_stage_view_get_framebuffer (get_stage_view (stage));
+  cogl_context = cogl_framebuffer_get_context (stage_fb);
+
+  /* An optional local factory profile exercises a real CLUT without making
+   * product calibration tables part of the synthetic upstream regression.
+   */
+  if (profile_path)
+    {
+      g_autofree char *bytes = NULL;
+      g_autoptr (GError) error = NULL;
+      gsize length;
+      ClutterLuminance luminance = native_hdr_luminance;
+      cmsHPROFILE profile;
+      const cmsCIEXYZ *white, *black;
+
+      g_assert_true (g_file_get_contents (profile_path, &bytes, &length, &error));
+      profile = cmsOpenProfileFromMem (bytes, length);
+      g_assert_nonnull (profile);
+      white = cmsReadTag (profile, cmsSigLuminanceTag);
+      black = cmsReadTag (profile, cmsSigMediaBlackPointTag);
+      g_assert_nonnull (white);
+      g_assert_nonnull (black);
+      luminance.max = luminance.mastering_max = white->Y;
+      luminance.min = black->Y * white->Y;
+      cmsCloseProfile (profile);
+      g_clear_object (&output);
+      output = clutter_color_state_icc_new_with_luminance (
+        clutter_test_get_context (), (uint8_t *) bytes, length,
+        &luminance, &error);
+      g_assert_no_error (error);
+      g_assert_nonnull (output);
+    }
+  linear = clutter_color_state_get_blending (output, FALSE);
+
+  fb = cogl_offscreen_new_from_formats (cogl_context, formats, G_N_ELEMENTS (formats),
+                                        1, 1, NULL);
+  g_assert_nonnull (fb);
+  cogl_framebuffer_orthographic (COGL_FRAMEBUFFER (fb), 0, 0, 1, 1, -1, 1);
+  pipeline = cogl_pipeline_new (cogl_context);
+  cogl_pipeline_add_snippet (pipeline, input);
+  clutter_color_state_add_pipeline_transform (linear, output, pipeline,
+                                               CLUTTER_COLOR_STATE_TRANSFORM_OPAQUE);
+
+  for (int i = 0; i < (profile_path ? G_N_ELEMENTS (levels) : 5); i++)
+    for (int pattern = 0; pattern < (profile_path ? G_N_ELEMENTS (patterns) : 1); pattern++)
+    {
+      float rgb[] = { levels[i] * patterns[pattern][0],
+                      levels[i] * patterns[pattern][1],
+                      levels[i] * patterns[pattern][2] };
+      float cpu[] = { rgb[0], rgb[1], rgb[2] };
+      float gpu[4];
+
+      clutter_color_state_do_transform (linear, output, cpu, 1);
+      /* Cogl's constant colour is 8-bit. Feed real sub-code-value linear
+       * samples through a float uniform so this measures LUT precision.
+       */
+      cogl_pipeline_set_uniform_float (
+        pipeline, cogl_pipeline_get_uniform_location (pipeline, "input_rgb"), 3, 1, rgb);
+      cogl_framebuffer_draw_rectangle (COGL_FRAMEBUFFER (fb), pipeline, 0, 0, 1, 1);
+      cogl_framebuffer_read_pixels (COGL_FRAMEBUFFER (fb), 0, 0, 1, 1,
+                                     COGL_PIXEL_FORMAT_RGBA_FP_32323232_PRE,
+                                     (uint8_t *) gpu);
+      g_test_message ("Linear level %.6f pattern %d: CPU %.6f GPU %.6f",
+                       levels[i], pattern, cpu[1], gpu[1]);
+      for (int channel = 0; channel < 3; channel++)
+        {
+          maximum_error = MAX (maximum_error, fabsf (gpu[channel] - cpu[channel]));
+          g_assert_cmpfloat_with_epsilon (gpu[channel], cpu[channel], 1.0f / 1023.0f);
+        }
+    }
+  g_test_message ("Native HDR maximum RGB error: %.8f", maximum_error);
+
+  if (profile_path)
+    {
+      g_autoptr (ClutterColorState) pq = clutter_color_state_params_new (
+        clutter_test_get_context (), CLUTTER_COLORSPACE_BT2020,
+        CLUTTER_TRANSFER_FUNCTION_PQ);
+      g_autoptr (CoglOffscreen) blending_fb = cogl_offscreen_new_from_formats (
+        cogl_context, formats, G_N_ELEMENTS (formats), 1, 1, NULL);
+      const float nits[] = { 0.5f, 0.73f, 1.0f, 2.0f, 10.0f };
+
+      g_assert_nonnull (blending_fb);
+      cogl_framebuffer_orthographic (COGL_FRAMEBUFFER (blending_fb), 0, 0, 1, 1, -1, 1);
+      maximum_error = 0.0f;
+      for (int i = 0; i < G_N_ELEMENTS (nits); i++)
+        {
+          g_autoptr (CoglPipeline) ingress = cogl_pipeline_new (cogl_context);
+          g_autoptr (CoglPipeline) egress = cogl_pipeline_new (cogl_context);
+          g_autoptr (CoglSnippet) input = cogl_snippet_new (
+            COGL_SNIPPET_HOOK_FRAGMENT, "uniform float input_pq;",
+            "cogl_color_out = vec4 (vec3 (input_pq), 1.0);");
+          float power = powf (nits[i] / 10000.0f, 0.1593017578125f);
+          float encoded = powf ((0.8359375f + 18.8515625f * power) /
+                                (1.0f + 18.6875f * power), 78.84375f);
+          float cpu[] = { encoded, encoded, encoded };
+          float gpu[4];
+
+          clutter_color_state_do_transform (pq, linear, cpu, 1);
+          clutter_color_state_do_transform (linear, output, cpu, 1);
+          cogl_pipeline_add_snippet (ingress, input);
+          cogl_pipeline_set_uniform_1f (
+            ingress, cogl_pipeline_get_uniform_location (ingress, "input_pq"), encoded);
+          clutter_color_state_add_pipeline_transform (pq, linear, ingress,
+                                                       CLUTTER_COLOR_STATE_TRANSFORM_OPAQUE);
+          cogl_framebuffer_draw_rectangle (COGL_FRAMEBUFFER (blending_fb), ingress, 0, 0, 1, 1);
+
+          cogl_pipeline_set_layer_texture (egress, 0, cogl_offscreen_get_texture (blending_fb));
+          clutter_color_state_add_pipeline_transform (linear, output, egress,
+                                                       CLUTTER_COLOR_STATE_TRANSFORM_OPAQUE);
+          cogl_framebuffer_draw_rectangle (COGL_FRAMEBUFFER (fb), egress, 0, 0, 1, 1);
+          cogl_framebuffer_read_pixels (COGL_FRAMEBUFFER (fb), 0, 0, 1, 1,
+                                         COGL_PIXEL_FORMAT_RGBA_FP_32323232_PRE,
+                                         (uint8_t *) gpu);
+          for (int channel = 0; channel < 3; channel++)
+            maximum_error = MAX (maximum_error, fabsf (gpu[channel] - cpu[channel]));
