diff --git a/clutter/clutter/clutter-icc-transform.c b/clutter/clutter/clutter-icc-transform.c
new file mode 100644
index 0000000..d40e557
--- /dev/null
+++ b/clutter/clutter/clutter-icc-transform.c
@@ -0,0 +1,409 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "config.h"
+
+#include "clutter/clutter-icc-transform.h"
+
+#include <gio/gio.h>
+#include <math.h>
+
+#include "cogl-half-float.h"
+
+#define CURVE_SIZE 16384
+#define CURVE_WIDTH 256
+#define CURVE_HEIGHT (CURVE_SIZE / CURVE_WIDTH)
+#define INPUT_CURVE_LAYER 11
+#define GAMUT_LAYER 12
+#define OUTPUT_CURVE_LAYER 13
+
+struct _ClutterIccTransform
+{
+  float matrix[9];
+  float offset[3];
+  unsigned int grid[3];
+
+  uint16_t *input_curves;
+  uint16_t *gamut;
+  uint16_t *output_curves;
+
+  CoglTexture *input_texture;
+  CoglTexture *gamut_texture;
+  CoglTexture *output_texture;
+};
+
+typedef struct
+{
+  float input[3];
+  float output[3];
+} ClutNode;
+
+static cmsPipeline *
+copy_stages (cmsStage *first,
+             cmsStage *after_last)
+{
+  cmsPipeline *pipeline = cmsPipelineAlloc (NULL, 3, 3);
+
+  for (cmsStage *stage = first; stage != after_last; stage = cmsStageNext (stage))
+    cmsPipelineInsertStage (pipeline, cmsAT_END, cmsStageDup (stage));
+
+  return pipeline;
+}
+
+static gboolean
+extract_matrix (ClutterIccTransform *transform,
+                cmsPipeline        *pipeline)
+{
+  const float origin[] = { 0.0f, 0.0f, 0.0f };
+  const float probes[][3] = {
+    { 0.25f, 0.5f, 0.75f }, { 0.5f, 0.5f, 0.5f },
+    { 0.01f, 0.001f, 0.0001f },
+  };
+
+  cmsPipelineEvalFloat (origin, transform->offset, pipeline);
+  for (int column = 0; column < 3; column++)
+    {
+      float input[] = { 0.0f, 0.0f, 0.0f };
+      float output[3];
+
+      input[column] = 1.0f;
+      cmsPipelineEvalFloat (input, output, pipeline);
+      for (int row = 0; row < 3; row++)
+        transform->matrix[column * 3 + row] = output[row] - transform->offset[row];
+    }
+
+  /* Prefix curve stages are only folded into the matrix when they are
+   * actually affine. A non-linear prefix needs a different GPU operation.
+   */
+  for (int i = 0; i < G_N_ELEMENTS (probes); i++)
+    {
+      float output[3];
+
+      cmsPipelineEvalFloat (probes[i], output, pipeline);
+      for (int row = 0; row < 3; row++)
+        {
+          float expected = transform->offset[row];
+
+          for (int column = 0; column < 3; column++)
+            expected += transform->matrix[column * 3 + row] * probes[i][column];
+          if (!G_APPROX_VALUE (expected, output[row], 0.000001f))
+            return FALSE;
+        }
+    }
+
+  return TRUE;
+}
+
+static uint16_t *
+sample_curves (cmsPipeline *pipeline)
+{
+  uint16_t *values = g_new (uint16_t, CURVE_SIZE * 4);
+
+  /* The ICC's separate one-dimensional curves keep the steep LCD black
+   * transition out of the gamut CLUT. A shaped 16K axis resolves that toe
+   * to less than one 10-bit output code, including half-float storage.
+   */
+  for (unsigned int i = 0; i < CURVE_SIZE; i++)
+    {
+      float value = powf (i / (float) (CURVE_SIZE - 1), 2.2f);
+      float input[] = { value, value, value };
+      float output[3];
+
+      cmsPipelineEvalFloat (input, output, pipeline);
+      for (int channel = 0; channel < 3; channel++)
+        values[i * 4 + channel] = cogl_float_to_half (output[channel]);
+      values[i * 4 + 3] = cogl_float_to_half (1.0f);
+    }
+
+  return values;
+}
+
+static cmsInt32Number
+collect_clut_node (const cmsFloat32Number input[],
+                   cmsFloat32Number       output[],
+                   void                  *user_data)
+{
+  GArray *nodes = user_data;
+  ClutNode node;
+
+  memcpy (node.input, input, sizeof (node.input));
+  memcpy (node.output, output, sizeof (node.output));
+  g_array_append_val (nodes, node);
+
+  return TRUE;
+}
+
+static gboolean
+extract_clut (ClutterIccTransform *transform,
+              cmsStage           *stage)
+{
+  g_autoptr (GArray) nodes = g_array_new (FALSE, FALSE, sizeof (ClutNode));
+  GArray *axis[3];
+  gboolean success = FALSE;
+
+  for (int channel = 0; channel < 3; channel++)
+    axis[channel] = g_array_new (FALSE, FALSE, sizeof (float));
+
+  if (!cmsStageSampleCLutFloat (stage, collect_clut_node, nodes, SAMPLER_INSPECT))
+    goto out;
+
+  for (unsigned int i = 0; i < nodes->len; i++)
+    {
+      ClutNode *node = &g_array_index (nodes, ClutNode, i);
+
+      for (int channel = 0; channel < 3; channel++)
+        {
+          gboolean seen = FALSE;
+
+          for (unsigned int j = 0; j < axis[channel]->len; j++)
+            seen |= node->input[channel] == g_array_index (axis[channel], float, j);
+          if (!seen)
+            g_array_append_val (axis[channel], node->input[channel]);
+        }
+    }
+
+  for (int channel = 0; channel < 3; channel++)
+    {
+      transform->grid[channel] = axis[channel]->len;
+      if (transform->grid[channel] < 2)
+        goto out;
+    }
+  if (nodes->len != transform->grid[0] * transform->grid[1] * transform->grid[2])
+    goto out;
+
+  transform->gamut = g_new0 (uint16_t, nodes->len * 4);
+  for (unsigned int i = 0; i < nodes->len; i++)
+    {
+      ClutNode *node = &g_array_index (nodes, ClutNode, i);
+      unsigned int index[3];
+      unsigned int destination;
+
+      for (int channel = 0; channel < 3; channel++)
+        index[channel] = lroundf (node->input[channel] * (transform->grid[channel] - 1));
+      destination = index[0] + transform->grid[0] *
+        (index[1] + transform->grid[1] * index[2]);
+      for (int channel = 0; channel < 3; channel++)
+        transform->gamut[destination * 4 + channel] =
+          cogl_float_to_half (node->output[channel]);
+      transform->gamut[destination * 4 + 3] = cogl_float_to_half (1.0f);
+    }
+  success = TRUE;
+
+out:
+  for (int channel = 0; channel < 3; channel++)
+    g_array_unref (axis[channel]);
+  return success;
+}
+
+ClutterIccTransform *
+clutter_icc_transform_new (cmsHPROFILE   profile,
+                           GError      **error)
+{
+  cmsPipeline *pipeline = cmsReadTag (profile, cmsSigBToD1Tag);
+  ClutterIccTransform *transform = g_new0 (ClutterIccTransform, 1);
+  cmsStage *first, *matrix, *pre, *clut, *post;
+  cmsPipeline *prefix_pipeline = NULL;
+  cmsPipeline *pre_pipeline = NULL;
+  cmsPipeline *post_pipeline = NULL;
+
+  if (!pipeline)
+    goto unsupported;
+
+  first = cmsPipelineGetPtrToFirstStage (pipeline);
+  matrix = first;
+  while (matrix && cmsStageType (matrix) == cmsSigCurveSetElemType)
+    matrix = cmsStageNext (matrix);
+  if (!matrix || cmsStageType (matrix) != cmsSigMatrixElemType)
+    goto unsupported;
+
+  pre = cmsStageNext (matrix);
+  clut = pre;
+  while (clut && cmsStageType (clut) == cmsSigCurveSetElemType)
+    clut = cmsStageNext (clut);
+  if (pre == clut || !clut || cmsStageType (clut) != cmsSigCLutElemType)
+    goto unsupported;
+
+  post = cmsStageNext (clut);
+  if (!post)
+    goto unsupported;
+  for (cmsStage *stage = post; stage; stage = cmsStageNext (stage))
+    if (cmsStageType (stage) != cmsSigCurveSetElemType)
+      goto unsupported;
+  for (cmsStage *stage = first; stage; stage = cmsStageNext (stage))
+    if (cmsStageInputChannels (stage) != 3 || cmsStageOutputChannels (stage) != 3)
+      goto unsupported;
+
+  prefix_pipeline = copy_stages (first, pre);
+  pre_pipeline = copy_stages (pre, clut);
+  post_pipeline = copy_stages (post, NULL);
+  if (!extract_matrix (transform, prefix_pipeline) ||
+      !extract_clut (transform, clut))
+    goto unsupported;
+
+  transform->input_curves = sample_curves (pre_pipeline);
+  transform->output_curves = sample_curves (post_pipeline);
+  cmsPipelineFree (prefix_pipeline);
+  cmsPipelineFree (pre_pipeline);
+  cmsPipelineFree (post_pipeline);
+
+  return transform;
+
+unsupported:
+  if (prefix_pipeline)
+    cmsPipelineFree (prefix_pipeline);
+  if (pre_pipeline)
+    cmsPipelineFree (pre_pipeline);
+  if (post_pipeline)
+    cmsPipelineFree (post_pipeline);
+  clutter_icc_transform_free (transform);
+  g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+               "ICC HDR output needs matrix, curves, RGB CLUT and output curves");
+  return NULL;
+}
+
+void
+clutter_icc_transform_free (ClutterIccTransform *transform)
+{
+  g_clear_object (&transform->input_texture);
+  g_clear_object (&transform->gamut_texture);
+  g_clear_object (&transform->output_texture);
+  g_free (transform->input_curves);
+  g_free (transform->gamut);
+  g_free (transform->output_curves);
+  g_free (transform);
+}
+
+static const char shader[] =
+  "uniform mat3 native_icc_matrix;\n"
+  "uniform vec3 native_icc_offset;\n"
+  "uniform vec3 native_icc_grid;\n"
+  "vec3 native_icc_curve_value (sampler2D table, float index)\n"
+  "{\n"
+  "  vec2 coordinate = vec2 (mod (index, 256.0), floor (index / 256.0));\n"
+  "  return texture (table, (coordinate + vec2 (0.5)) / vec2 (256.0, 64.0)).rgb;\n"
+  "}\n"
+  "vec3 native_icc_curves (sampler2D table, vec3 value)\n"
+  "{\n"
+  "  vec3 index = pow (clamp (value, 0.0, 1.0), vec3 (1.0 / 2.2)) * 16383.0;\n"
+  "  vec3 low = floor (index);\n"
+  "  vec3 high = min (low + vec3 (1.0), vec3 (16383.0));\n"
+  "  vec3 a = vec3 (native_icc_curve_value (table, low.r).r,\n"
+  "                 native_icc_curve_value (table, low.g).g,\n"
+  "                 native_icc_curve_value (table, low.b).b);\n"
+  "  vec3 b = vec3 (native_icc_curve_value (table, high.r).r,\n"
+  "                 native_icc_curve_value (table, high.g).g,\n"
+  "                 native_icc_curve_value (table, high.b).b);\n"
+  "  return mix (a, b, index - low);\n"
+  "}\n"
+  "vec3 native_icc_gamut_value (vec3 index)\n"
+  "{\n"
+  "  vec2 coordinate = vec2 (index.x, index.y + index.z * native_icc_grid.y);\n"
+  "  vec2 size = vec2 (native_icc_grid.x, native_icc_grid.y * native_icc_grid.z);\n"
+  "  return texture (cogl_sampler12, (coordinate + vec2 (0.5)) / size).rgb;\n"
+  "}\n"
+  "vec3 native_icc_gamut (vec3 value)\n"
+  "{\n"
+  "  vec3 position = clamp (value, 0.0, 1.0) * (native_icc_grid - vec3 (1.0));\n"
+  "  vec3 low = min (floor (position), native_icc_grid - vec3 (2.0));\n"
+  "  vec3 fraction = position - low;\n"
+  "  vec3 a, b, sorted;\n"
+  "  if (fraction.x >= fraction.y)\n"
+  "    {\n"
+  "      if (fraction.y >= fraction.z)\n"
+  "        { a = vec3 (1,0,0); b = vec3 (0,1,0); sorted = fraction.xyz; }\n"
+  "      else if (fraction.x >= fraction.z)\n"
+  "        { a = vec3 (1,0,0); b = vec3 (0,0,1); sorted = fraction.xzy; }\n"
+  "      else\n"
+  "        { a = vec3 (0,0,1); b = vec3 (1,0,0); sorted = fraction.zxy; }\n"
+  "    }\n"
+  "  else\n"
+  "    {\n"
+  "      if (fraction.x >= fraction.z)\n"
+  "        { a = vec3 (0,1,0); b = vec3 (1,0,0); sorted = fraction.yxz; }\n"
+  "      else if (fraction.y >= fraction.z)\n"
+  "        { a = vec3 (0,1,0); b = vec3 (0,0,1); sorted = fraction.yzx; }\n"
+  "      else\n"
+  "        { a = vec3 (0,0,1); b = vec3 (0,1,0); sorted = fraction.zyx; }\n"
+  "    }\n"
+  "  vec3 v0 = native_icc_gamut_value (low);\n"
+  "  vec3 v1 = native_icc_gamut_value (low + a);\n"
+  "  vec3 v2 = native_icc_gamut_value (low + a + b);\n"
+  "  vec3 v3 = native_icc_gamut_value (low + vec3 (1.0));\n"
+  "  return v0 + sorted.x * (v1 - v0) + sorted.y * (v2 - v1) + sorted.z * (v3 - v2);\n"
+  "}\n"
+  "vec3 native_icc_output (vec3 xyz)\n"
+  "{\n"
+  "  xyz = clamp (xyz, 0.0, 1.0);\n"
+  "  vec3 value = native_icc_matrix * xyz + native_icc_offset;\n"
+  "  value = native_icc_curves (cogl_sampler11, value);\n"
+  "  value = native_icc_gamut (value);\n"
+  "  return native_icc_curves (cogl_sampler13, value);\n"
+  "}\n";
+
+void
+clutter_icc_transform_append_shader (ClutterIccTransform *transform,
+                                      GString             *globals,
+                                      GString             *source,
+                                      const char          *color_var)
+{
+  g_string_append (globals, shader);
+  g_string_append_printf (source, "  %s = native_icc_output (%s);\n", color_var, color_var);
+}
+
+static gboolean
+bind_texture (CoglContext  *context,
+              CoglPipeline *pipeline,
+              CoglTexture **texture,
+              int           layer,
+              int           width,
+              int           height,
+              uint16_t     *data,
+              GError      **error)
+{
+  if (!*texture)
+    *texture = cogl_texture_2d_new_from_data (
+      context, width, height, COGL_PIXEL_FORMAT_RGBX_FP_16161616,
+      width * 4 * sizeof (uint16_t), (uint8_t *) data, error);
+  if (!*texture)
+    return FALSE;
+
+  cogl_pipeline_set_layer_texture (pipeline, layer, *texture);
+  cogl_pipeline_set_layer_combine (pipeline, layer, "RGBA = REPLACE(PREVIOUS)", NULL);
+  cogl_pipeline_set_layer_wrap_mode_s (pipeline, layer, COGL_PIPELINE_WRAP_MODE_CLAMP_TO_EDGE);
+  cogl_pipeline_set_layer_wrap_mode_t (pipeline, layer, COGL_PIPELINE_WRAP_MODE_CLAMP_TO_EDGE);
+  cogl_pipeline_set_layer_filters (pipeline, layer, COGL_PIPELINE_FILTER_NEAREST,
+                                  COGL_PIPELINE_FILTER_NEAREST);
+  return TRUE;
+}
+
+gboolean
+clutter_icc_transform_update_uniforms (ClutterIccTransform *transform,
+                                      CoglContext         *context,
+                                      CoglPipeline        *pipeline,
+                                      GError             **error)
+{
+  float grid[3];
+
+  if (!bind_texture (context, pipeline, &transform->input_texture,
+                      INPUT_CURVE_LAYER, CURVE_WIDTH, CURVE_HEIGHT,
+                      transform->input_curves, error) ||
+      !bind_texture (context, pipeline, &transform->gamut_texture,
+                      GAMUT_LAYER, transform->grid[0],
+                      transform->grid[1] * transform->grid[2], transform->gamut, error) ||
+      !bind_texture (context, pipeline, &transform->output_texture,
+                      OUTPUT_CURVE_LAYER, CURVE_WIDTH, CURVE_HEIGHT,
+                      transform->output_curves, error))
+    return FALSE;
+
+  for (int channel = 0; channel < 3; channel++)
+    grid[channel] = transform->grid[channel];
+  cogl_pipeline_set_uniform_matrix (
+    pipeline, cogl_pipeline_get_uniform_location (pipeline, "native_icc_matrix"),
+    3, 1, FALSE, transform->matrix);
+  cogl_pipeline_set_uniform_float (
+    pipeline, cogl_pipeline_get_uniform_location (pipeline, "native_icc_offset"),
+    3, 1, transform->offset);
+  cogl_pipeline_set_uniform_float (
+    pipeline, cogl_pipeline_get_uniform_location (pipeline, "native_icc_grid"),
+    3, 1, grid);
+  return TRUE;
+}
