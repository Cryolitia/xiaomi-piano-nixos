+/**
+ * clutter_color_state_icc_new_with_luminance:
+ *
+ * Create an ICC output colour state with the display's explicit luminance.
+ * ICC PCS values remain relative to display white; luminance mapping and
+ * HDR tone mapping happen before the profile's XYZ-to-device conversion.
+ */
+ClutterColorState *
+clutter_color_state_icc_new_with_luminance (ClutterContext          *context,
+                                            const uint8_t           *icc_bytes,
+                                            uint32_t                 icc_length,
+                                            const ClutterLuminance  *luminance,
+                                            GError                 **error)
+{
+  return clutter_color_state_icc_new_full (context,
+                                           icc_bytes,
+                                           icc_length,
+                                           CLUTTER_COLOR_STATE_ICC_FLAG_NONE,
+                                           luminance,
+                                           error);
