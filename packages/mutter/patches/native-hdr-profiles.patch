+
+/**
+ * clutter_color_state_icc_with_luminance:
+ *
+ * Derive a colour state for a new physical brightness without reparsing the
+ * ICC profile or regenerating its luminance-independent LCMS transforms.
+ */
+ClutterColorState *
+clutter_color_state_icc_with_luminance (ClutterColorStateIcc   *color_state_icc,
+                                      const ClutterLuminance *luminance)
+{
+  const ClutterLuminance *old = &color_state_icc->luminance;
+
+  if (old->type == luminance->type &&
+      G_APPROX_VALUE (old->min, luminance->min, 0.0001f) &&
+      G_APPROX_VALUE (old->max, luminance->max, 0.0001f) &&
+      G_APPROX_VALUE (old->ref, luminance->ref, 0.0001f) &&
+      G_APPROX_VALUE (old->mastering_max, luminance->mastering_max, 0.0001f))
+    return g_object_ref (CLUTTER_COLOR_STATE (color_state_icc));
+
+  return new_from_icc_data (
+    clutter_color_state_get_context (CLUTTER_COLOR_STATE (color_state_icc)),
+    color_state_icc->data, color_state_icc->is_linear, luminance);
+}
