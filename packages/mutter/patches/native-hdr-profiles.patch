+static double
+get_native_hdr_peak_fraction (MetaColorDevice     *color_device,
+                              const MetaOutputInfo *output_info)
+{
+  MetaBacklight *backlight = meta_monitor_get_backlight (color_device->monitor);
+  double brightness;
+  int minimum, maximum;
+
+  if (backlight != color_device->native_hdr_backlight)
+    {
+      g_clear_signal_handler (&color_device->native_hdr_brightness_handler_id,
+                              color_device->native_hdr_backlight);
+      g_set_object (&color_device->native_hdr_backlight, backlight);
+      if (backlight)
+        color_device->native_hdr_brightness_handler_id =
+          g_signal_connect (backlight, "notify::brightness",
+                            G_CALLBACK (on_native_hdr_brightness_changed),
+                            color_device);
+    }
+
+  if (!backlight)
+    return 1.0;
+  meta_backlight_get_brightness_info (backlight, &minimum, &maximum);
+  brightness = meta_backlight_get_brightness (backlight) / (double) maximum;
+
+  for (unsigned int i = 1; i < output_info->native_hdr_backlight_curve->len; i++)
+    {
+      MetaNativeHdrBacklightPoint a = g_array_index (
+        output_info->native_hdr_backlight_curve, MetaNativeHdrBacklightPoint, i - 1);
+      MetaNativeHdrBacklightPoint b = g_array_index (
+        output_info->native_hdr_backlight_curve, MetaNativeHdrBacklightPoint, i);
+
+      if (brightness <= b.brightness)
+        {
+          double t = (brightness - a.brightness) / (b.brightness - a.brightness);
+
+          /* Keep normalisation finite while the physical backlight is off. */
+          return MAX (a.luminance + t * (b.luminance - a.luminance), 0.00001);
+        }
+    }
+
+  return 1.0;
+}
