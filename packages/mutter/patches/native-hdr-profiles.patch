+static void
+on_native_hdr_brightness_changed (MetaBacklight   *backlight,
+                                  GParamSpec      *pspec,
+                                  MetaColorDevice *color_device)
+{
+  /* Brightness can change during a frame-clock dispatch. Rebuild colour
+   * state in an idle, as the reference-white backlight already does.
